# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Porta do servidor (padrão: 3000)
PORT="3000"

# MYSQL 8 CONFIGURATION (VPS Hostinger)
# Quando configurados, o backend conecta diretamente ao MySQL 8 de produção.
# Se ausentes (modo dev/preview), utiliza o repositório em memória/sqlite integrado.
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_DATABASE="u366235819_smartvendas"
MYSQL_USER="u366235819_smart"
MYSQL_PASSWORD="sua_senha_mysql"

# AUTENTICAÇÃO E FUSO HORÁRIO
JWT_SECRET="chave_secreta_para_tokens_jwt"
TIMEZONE="America/Sao_Paulo"
